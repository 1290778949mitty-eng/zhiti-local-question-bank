{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zhiti-local-question-bank",
  "account_id": "7a5978bf799135f5848744e55cbeb411",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-05-22",
  "main": "./worker/index.ts",
  "routes": [
    {
      "pattern": "tiku.mittysapce.uk",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zhiti-question-bank",
      "database_id": "8d93b3dc-001f-4f32-adba-4bb5dc971c17",
      "migrations_dir": "migrations"
    }
  ],
  "cache": {
    "enabled": true
  }
}
