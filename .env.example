OPENAI_BASE_URL=https://你的-sub2api-域名
OPENAI_API_KEY=你的_Sub2API_Key
OPENAI_VISION_MODEL=gemini-3.7-flash
OPENAI_TEXT_MODEL=gemini-3.7-flash
OPENAI_REASONING_EFFORT=high
# 识别以准确抄录为主，独立使用低推理档位可显著缩短照片等待时间
OPENAI_RECOGNITION_REASONING_EFFORT=low
OPENAI_DIAGRAM_REASONING_EFFORT=medium
# auto 会优先使用 Responses，失败时自动尝试 Chat Completions
OPENAI_API_MODE=antigravity_gemini

# 云端注册配置只应通过 Wrangler Secret 设置，不要写入 .env.local 后提交。
# ADMIN_EMAIL=你的管理员邮箱
# REGISTRATION_INVITE_CODE=你发给会员的邀请码

# localhost 一键发布公共资源库。两端的发布密钥必须相同，线上只通过 Wrangler Secret 配置。
# LOCAL_ADMIN_MODE 由 npm run dev 自动注入；绝对不要配置为线上 Cloudflare Secret。
# PUBLIC_LIBRARY_REMOTE_URL=https://tiku.mittysapce.uk
# PUBLIC_LIBRARY_PUBLISH_TOKEN=至少-32-字节随机密钥
